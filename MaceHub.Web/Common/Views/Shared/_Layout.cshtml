<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Mace Hub" : "Mace Hub")</title>

    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"></script>
</head>
<body class="min-h-screen bg-base-200 text-base-content">
    <div class="navbar bg-base-300">
        <div class="flex-1">
            <a href="/" class="btn btn-ghost text-xl">Mace Hub</a>
        </div>
    </div>

    <main class="container mx-auto p-6">
        @RenderBody()
    </main>

    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

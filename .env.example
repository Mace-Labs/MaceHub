# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- Postgres container credentials (consumed by the `db` service) ---
POSTGRES_USER=macehub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=macehub

# --- App database connection (single source of truth) ---
# .NET double-underscore convention → IConfiguration.GetConnectionString("Default").
# Host MUST match the compose service name (`db`); credentials must match the three
# POSTGRES_* values above.
ConnectionStrings__Default=Host=db;Port=5432;Database=macehub;Username=macehub;Password=change-me-strong-password

# --- Anthropic API key ---
# Used only inside AnthropicLlmClient. The scaffold makes NO live calls — it just reads
# this to prove the client resolves from DI.
ANTHROPIC_API_KEY=sk-ant-your-key-here
